# Copy this file to .env and fill in real values. Never commit .env.

# Neon DIRECT connection strings (hostname without "-pooler"), pasted as-is.
# Development database: Neon "production" branch.
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Test database used by pytest: Neon "test" branch.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@ep-example-654321.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# JWT signing. Generate a secret with: uv run python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
